{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Config files run in Node, so they get Node types and nothing from the browser.
    // Vite bundles them before running them, hence bundler-style import resolution.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}

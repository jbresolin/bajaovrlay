{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Config files and Playwright tests run in Node, so they get Node types; the DOM
    // library is there for the code Playwright tests run inside the page.
    // Vite and Playwright bundle these files before running them, hence bundler-style
    // import resolution.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.chaos.config.ts",
    "e2e"
  ]
}

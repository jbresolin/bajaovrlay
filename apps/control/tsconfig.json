{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles this code for the browser, so imports resolve the way a bundler
    // resolves them (no `.js` suffixes) instead of the NodeNext rules the server uses.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // Checked by tsconfig.node.json, with Node's types: they read files from the disk.
  "exclude": ["src/fonts/controlPageFontCoversPtBR.test.ts", "src/i18n/operatorGuideLabels.test.ts"]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles this code for the browser, so imports resolve the way a bundler
    // resolves them instead of the NodeNext rules the server uses.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src"]
}

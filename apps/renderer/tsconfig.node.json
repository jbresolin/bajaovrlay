{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Config files and Playwright tests run in Node; the page itself runs in the browser.
    // Vite and Playwright bundle these files before running them, hence bundler-style
    // import resolution.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e"]
}

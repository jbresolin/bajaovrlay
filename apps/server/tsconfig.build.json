{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    // The built server must import @bajaovrlay/shared from its built `dist`, not from
    // its TypeScript source, so the source condition is switched off for the build.
    "customConditions": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.testSupport.ts"]
}

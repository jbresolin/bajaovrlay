{
  "name": "@bajaovrlay/server",
  "version": "0.0.0",
  "private": true,
  "description": "The BajaOvrLay server: owns all state, serves the control page and the renderer.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@bajaovrlay/source --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "benchmark:replay-loading": "tsx --conditions=@bajaovrlay/source src/modules/dataSources/adapters/replay/replayLoading.benchmark.ts"
  },
  "dependencies": {
    "@bajaovrlay/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "obs-websocket-js": "^5.0.8",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vite": "^8.3.3"
  }
}

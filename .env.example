# BajaOvrLay server environment. Copy to `.env` and adjust; `.env` is never committed.
# Every variable is optional: the value shown here is the default the server uses.
#
# Three places run the server, and each note below says what to set in each:
#   - dev: `pnpm dev` on a checkout, reading this file as `.env` at the repository root;
#   - stream PC, BajaOvrLay's home: the Docker image under Docker Desktop, offline
#     (deploy/stream-pc/README.md);
#   - TrueNAS, optional: the Docker image as a Portainer stack, set under the stack's
#     "Environment variables" (deploy/truenas/README.md).
# The Docker image sets PORT=8080, HOST=0.0.0.0, DATABASE_PATH=/data/bajaovrlay.sqlite and
# DATA_DIR=/data itself (Dockerfile); leave those four unset on TrueNAS and the stream PC.

# TCP port the server listens on. The control page dev server reads this file too and
# proxies /api, /ws and /health to this port (and to HOST, or 127.0.0.1 for 0.0.0.0).
# dev: 3000. Image: 8080, set by the image; publish another host port instead
# (`-p 9090:8080`) rather than changing it.
PORT=3000

# Network interface to listen on. 127.0.0.1 keeps the server reachable only from this
# machine; use 0.0.0.0 to let an operator on another machine open the control page.
# dev: 127.0.0.1. Image: 0.0.0.0, set by the image (Docker's port mapping decides who
# reaches it).
HOST=127.0.0.1

# Minimum log level: fatal, error, warn, info, debug, trace or silent.
# Everywhere: info. Read the image's lines with `docker logs bajaovrlay`.
LOG_LEVEL=info

# Where the SQLite database file lives. A relative path is read from the repository
# root (wherever the server is started from); the folder is created if it is missing.
# The default folder, apps/server/data/, is gitignored. Delete the file to start over:
# the next boot seeds the fixed layers again.
# dev: the default. Image: /data/bajaovrlay.sqlite, set by the image, inside the /data
# volume, so a backup of that one folder is the whole install.
DATABASE_PATH=apps/server/data/bajaovrlay.sqlite

# Where the server keeps its other files: the recordings of data sources go in
# DATA_DIR/recordings/<sourceId>/, one .jsonl file per recording. A relative path is
# read from the repository root, like DATABASE_PATH; the folder is created when the
# first recording starts. The default folder, apps/server/data/, is gitignored.
# Uploaded images go in DATA_DIR/media/, and the backup command's copies wherever it is
# told (/backups on TrueNAS, a mount of its own). dev: the default. Image: /data, set by
# the image.
DATA_DIR=apps/server/data

# Secrets of flex HTTP/JSON data sources (a token, an API key). A source's config never
# holds a secret: a header or query parameter names a variable instead, and the server
# reads it at every poll. Only names starting with BAJAOVRLAY_SOURCE_ (then capitals,
# digits or "_") are accepted, so a config cannot name any other server variable. The
# prefix alone does not stop a secret leaving: a config could point at any address, so a
# variable's value is only sent to a host on BAJAOVRLAY_SOURCE_ALLOWED_HOSTS (below).
# No default: set one per secret a source needs, for example a header
# { "name": "Authorization", "valueFromEnvironment": "BAJAOVRLAY_SOURCE_BAJA_TOKEN" }:
# BAJAOVRLAY_SOURCE_BAJA_TOKEN=Bearer cole-o-token-aqui
# dev, TrueNAS and stream PC alike: one per secret a source of that machine needs. On the
# stream PC, add them to the compose file under `environment:`.

# The hosts a flex source may fetch, comma-separated: "host" allows that host on any port,
# "host:port" only that port (an address with no port is port 80 for http, 443 for https);
# capitals do not matter, and an IPv6 host goes in brackets ([::1]:4790). With the list
# set, a request to any other host is refused, and so is saving a source that makes one.
# Not set (the default), or set to nothing: any host may be fetched, but a request that
# names a BAJAOVRLAY_SOURCE_ variable is refused, and the server logs a warning at boot.
# An entry that is not a host or host:port stops the boot. For example:
# BAJAOVRLAY_SOURCE_ALLOWED_HOSTS=cronometragem.local:8080,api.bajasaebrasil.org.br
# dev: unset, unless you test a secret. TrueNAS and stream PC: the timing systems that
# machine polls, as soon as any source uses a secret.

# The public addresses of a reverse proxy in front of the server, comma-separated, each an
# http or https address with nothing after the host and port. A page opened at one of them
# may upload images (Cadastros), as a page of the server's own address always may. Needed
# behind Nginx Proxy Manager, which ends HTTPS: the request then reaches the server as
# http://<domain> while the page is https://<domain>, and without this every upload is
# refused ("Imagens só podem ser enviadas pela página Cadastros deste servidor"). An entry
# that is not such an address stops the boot. Not set (the default): none.
# dev and stream PC: unset. TrueNAS: the address NPM serves, for example:
# BAJAOVRLAY_PUBLIC_ORIGINS=https://bajaovrlay.casa.lan

# The devices that may send commands over HTTP (Companion, a Stream Deck, a script; see
# docs/buttons.md): one name=token pair per device, separated by commas. The name is
# 1 to 40 letters, digits, "-" or "_" (not "rede", kept for calls with no token) and signs
# the device's commands in the event log as api:<name>; the token is at least 16
# characters with no space (make one with `openssl rand -hex 16`), sent as
# "Authorization: Bearer <token>". Spaces around a name or a token are ignored. A token is
# never written to the log, only its name. Not set (the default), or set to nothing, and
# BAJAOVRLAY_API_OPEN not true: the command API is off and answers 403. An entry that
# cannot be used, a name listed twice or one token given to two devices stops the boot.
# dev: unset, unless you try a pad. Stream PC: one per device that can send a header
# (Companion), in the compose file under `environment:`. TrueNAS: the same, under the
# stack's "Environment variables".
# For example, with each <...> replaced by the output of its own `openssl rand -hex 16`:
# BAJAOVRLAY_API_TOKENS=companion=<openssl rand -hex 16>,streamdeck=<openssl rand -hex 16>

# The command API open to the whole network, with no token: true or false (any other word
# stops the boot). Only for the dedicated studio network, where the control page has no
# login either: any machine on it may then put graphics on air. It is for buttons that
# cannot send a header once for all, such as the Ulanzi D200 (docs/buttons.md). A call
# with no token is signed api:rede, and its log line carries the address it came from; a
# device with a token in BAJAOVRLAY_API_TOKENS is still named, and a wrong token is still
# refused. The boot log warns while it is on. Not set (the default): not open.
# dev: unset. Stream PC on the studio network: true, in the compose file under
# `environment:`. TrueNAS: never; it is not the studio network.
# BAJAOVRLAY_API_OPEN=true

# Where OBS's WebSocket server is (docs/obs.md): ws:// or wss://, the host and the port, as
# OBS 32 shows it in Tools → WebSocket Server Settings. The server keeps one connection to
# it, tries again every 5 s while OBS is closed, and nothing else waits for OBS. Not set (the
# default), or set to nothing: OBS control is off and the control page says "OBS não
# configurado". An address that is not ws:// or wss:// stops the boot.
# dev: ws://127.0.0.1:4455 when OBS runs on the same machine. Stream PC: the image runs in
# Docker, where 127.0.0.1 is the container itself, so use the PC's own name for it,
# ws://host.docker.internal:4455, in the compose file under `environment:`. TrueNAS: unset.
# BAJAOVRLAY_OBS_URL=ws://127.0.0.1:4455

# OBS's WebSocket password, as OBS shows it under "Show Connect Info". Not set, or set to
# nothing: no password is sent (OBS's authentication off). Never written to the log or sent to
# a page. Wherever BAJAOVRLAY_OBS_URL is set, beside it.
# BAJAOVRLAY_OBS_PASSWORD=<a senha do OBS>

# Browser tests only (pnpm test:e2e), never the server: moves every port the Playwright
# runs use (5176, 5178, 5184, 5185, 5186, 5187, 5188) by this many, so two checkouts of the
# repository can run their browser tests at the same time. Not set: 0, the ports above.
# BAJAOVRLAY_E2E_PORT_OFFSET=100

{
  "name": "@bajaovrlay/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and types shared by the server, the control page and the renderer.",
  "type": "module",
  "exports": {
    ".": {
      "@bajaovrlay/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./clock": {
      "@bajaovrlay/source": "./src/clock/index.ts",
      "types": "./dist/clock/index.d.ts",
      "default": "./dist/clock/index.js"
    },
    "./sponsorLevels": {
      "@bajaovrlay/source": "./src/entities/sponsorLevels.ts",
      "types": "./dist/entities/sponsorLevels.d.ts",
      "default": "./dist/entities/sponsorLevels.js"
    },
    "./scheduleSlotStatus": {
      "@bajaovrlay/source": "./src/entities/scheduleSlotStatus.ts",
      "types": "./dist/entities/scheduleSlotStatus.d.ts",
      "default": "./dist/entities/scheduleSlotStatus.js"
    },
    "./scheduleSlotStatusScenarios.testSupport": {
      "@bajaovrlay/source": "./src/entities/scheduleSlotStatusScenarios.testSupport.ts"
    },
    "./bracketSteps": {
      "@bajaovrlay/source": "./src/steps/bracketSteps.ts",
      "types": "./dist/steps/bracketSteps.d.ts",
      "default": "./dist/steps/bracketSteps.js"
    },
    "./raceTimeText": {
      "@bajaovrlay/source": "./src/raceTimeText/index.ts",
      "types": "./dist/raceTimeText/index.d.ts",
      "default": "./dist/raceTimeText/index.js"
    },
    "./samples/positions.json": "./src/dataShapes/samples/positions.enduro-lap-34.json",
    "./samples/brackets.super-prime.json": "./src/dataShapes/samples/brackets.super-prime.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}

{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "baja-logo-bug",
  "version": "0.1.0",
  "name": "Logo do canal",
  "description": "Uma imagem fixa da biblioteca de mídia, no canto da tela que o item escolhe.",
  "author": {
    "name": "BajaOvrLay"
  },
  "main": "logo-bug.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "v_baja": {
    "defaultLayerId": "channel-logo",
    "category": "brand"
  },
  "actionDurations": [
    { "type": "playAction", "duration": 400 },
    { "type": "stopAction", "duration": 250 }
  ],
  "schema": {
    "type": "object",
    "properties": {
      "logoUrl": {
        "type": "string",
        "title": "Imagem",
        "description": "O logo, escolhido na biblioteca de mídia dos cadastros (PNG ou SVG com fundo transparente).",
        "minLength": 1,
        "v_baja": { "role": "imageUrl" }
      },
      "corner": {
        "type": "string",
        "title": "Canto",
        "description": "O canto da tela onde o logo fica, dentro da área segura.",
        "enum": ["top-left", "top-right", "bottom-left", "bottom-right"],
        "gddType": "select",
        "gddOptions": {
          "labels": {
            "top-left": "Superior esquerdo",
            "top-right": "Superior direito",
            "bottom-left": "Inferior esquerdo",
            "bottom-right": "Inferior direito"
          }
        },
        "default": "bottom-right"
      },
      "heightPx": {
        "type": "integer",
        "title": "Altura (px)",
        "description": "A altura do logo na tela de 1920x1080; a largura acompanha.",
        "minimum": 32,
        "maximum": 200,
        "default": 80
      },
      "opacityPercent": {
        "type": "integer",
        "title": "Opacidade (%)",
        "description": "100 é o logo inteiro; menos o deixa mais discreto sobre a imagem.",
        "minimum": 30,
        "maximum": 100,
        "default": 100
      }
    },
    "required": ["logoUrl"],
    "additionalProperties": false
  }
}

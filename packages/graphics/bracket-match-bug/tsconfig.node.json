{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Config files and Playwright tests run in Node; the graphic itself runs in the
    // browser. Vite and Playwright bundle these files, hence bundler-style resolution.
    // DOM types are needed because Playwright tests pass functions that run in the page.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e"]
}

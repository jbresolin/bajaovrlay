{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles this code for the browser (OBS's Chromium), so imports resolve the
    // way a bundler resolves them instead of the NodeNext rules the server uses.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // "node" only for the manifest test, which runs in plain Node and reads the theme's
    // token file from disk; the graphic itself never touches a Node API.
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}

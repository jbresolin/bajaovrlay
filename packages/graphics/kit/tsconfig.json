{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // The kit is bundled by Vite into each graphic for the browser (OBS's Chromium), so
    // imports resolve the way a bundler resolves them instead of the NodeNext rules.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // "node" only for the test that reads every graphic's manifest from disk.
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}

{
  "name": "bajaovrlay",
  "private": true,
  "description": "Stream graphics for Baja SAE Brasil live streams.",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "build": "node scripts/writeBuildId.js && pnpm --recursive --if-present run build && node scripts/publishBuildId.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive --if-present run typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm test:e2e:renderer-and-graphics && pnpm test:e2e:control",
    "test:e2e:renderer-and-graphics": "pnpm test:e2e:renderer-bracket-tower && pnpm test:e2e:other-graphics-and-server",
    "test:e2e:renderer-bracket-tower": "pnpm --recursive --workspace-concurrency=1 --filter @bajaovrlay/renderer --filter @bajaovrlay/bracket --filter @bajaovrlay/positions-tower run test:e2e",
    "test:e2e:other-graphics-and-server": "pnpm --recursive --workspace-concurrency=1 --filter '!@bajaovrlay/control' --filter '!@bajaovrlay/renderer' --filter '!@bajaovrlay/bracket' --filter '!@bajaovrlay/positions-tower' --if-present run test:e2e",
    "test:e2e:control": "pnpm --filter @bajaovrlay/control run test:e2e",
    "test:chaos": "node scripts/checkPortOffset.js && pnpm --filter @bajaovrlay/control run test:chaos",
    "verify": "node scripts/verify.js",
    "start": "pnpm --filter @bajaovrlay/server run start",
    "serve:flex-example": "node scripts/serveFlexExample.js",
    "serve:baja-example": "node scripts/serveBajaAppExample.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "catalog:",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}

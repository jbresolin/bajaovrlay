node_modules/
dist/
coverage/
# Written by `pnpm build`: the id the Vite builds embed (scripts/writeBuildId.js, first)
# and the copy the server reads at boot (scripts/publishBuildId.js, once every package built)
build-id.building.json
build-id.json

# Playwright output (CI uploads these as artifacts when a run fails)
test-results/
playwright-report/
# Vitest's JSON report on CI, read by scripts/reportSlowestTests.js
vitest-report.json

# Local data and secrets
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# Default home of the server database and data folder (DATABASE_PATH, DATA_DIR)
apps/server/data/
# Database of the control page's browser tests, made anew on every run
apps/control/e2e-data/
# ...and of its second server, the one with the operator login on (BAJAOVRLAY-29)
apps/control/e2e-data-login/
# Database and data folder (DATA_DIR) of the renderer's browser tests
apps/renderer/.e2e-data/
# Database and data folder of the built server's browser tests (apps/server/e2e)
apps/server/.e2e-data/
.env
.env.*
!.env.example

# Agent scratch space (PR bodies, notes)
.scratch/

*.log
.DS_Store

# Windows marks files copied from a download with an alternate-stream file of this name.
*:Zone.Identifier

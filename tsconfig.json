{
  // Typechecks the config files and the plain-Node scripts at the repository root (the
  // scripts are JavaScript, checked as strictly as the TypeScript). Each package has its
  // own tsconfig.json, checked by that package's `typecheck` script.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["vitest.config.ts", "scripts"]
}
